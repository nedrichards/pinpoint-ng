{
  "app-id": "com.nedrichards.pinpoint.Devel",
  "desktop-file-name-suffix": " (Development)",
  "rename-desktop-file": "com.nedrichards.pinpoint.desktop",
  "rename-appdata-file": "com.nedrichards.pinpoint.metainfo.xml",
  "rename-icon": "com.nedrichards.pinpoint",
  "copy-icon": true,
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "pinpoint",
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--socket=pulseaudio",
    "--own-name=org.mpris.MediaPlayer2.com.nedrichards.pinpoint.*"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/app/share/pinpoint/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },
  "cleanup": [
    "/share/pinpoint/cargo",
    "/share/doc",
    "/share/man"
  ],
  "modules": [
    {
      "name": "cargo-dependencies",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/share/pinpoint/cargo",
        "cp -a cargo/vendor /app/share/pinpoint/cargo/",
        "install -Dm644 cargo/config.toml /app/share/pinpoint/cargo/config.toml"
      ],
      "sources": [
        "flatpak/cargo-sources.json"
      ]
    },
    {
      "name": "pinpoint",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "skip": [
            "flatpak-repo",
            ".git",
            ".flatpak-builder*",
            "build-*",
            "flatpak-build*",
            "runtime-assets",
            "target",
            "vendor",
            "fuzz",
            "desktop-summit",
            "guadec-2018",
            "*.syscap",
            "_build*"
          ]
        }
      ],
      "builddir": true,
      "config-opts": [
        "-Dbuildtype=release"
      ],
      "run-tests": true
    }
  ]
}
